# TwinCity Frontend — Environment Variables
# ══════════════════════════════════════════
# Copy this file to .env and fill in values for your environment.
# .env is gitignored — never commit secrets.

# Base URL for the FastAPI backend (no trailing slash)
VITE_API_BASE=http://localhost:8000

# Cesium Ion Access Token
# Get your free token at: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=YOUR_CESIUM_ION_TOKEN_HERE
