*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ─── Frontend ─────────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
frontend/public/Cesium/

# ─── Environment / Secrets ────────────────────────────────────────────────────
.env
.env.*
# Example template is safe to commit — un-ignore it:
!.env.example

# ─── SUMO Outputs ─────────────────────────────────────────────────────────────
# Generated network files are reproducible from source data
sumo_tmp/
*.net.xml
*.rou.xml
*.sumocfg
sumo_output/
*.fcd.xml
*.tripinfo.xml

# ─── IDE / OS ─────────────────────────────────────────────────────────────────
