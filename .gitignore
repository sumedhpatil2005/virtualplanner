.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ─── TypeScript build cache ───────────────────────────────────────────────────
*.tsbuildinfo

