{
  "schema": "twincity.observed_counts/v1",
  "dataset_id": "pune_west_2026",
  "version": "1.0.0",
  "title": "Peak-hour classified turning counts at six intersections in west Pune",
  "data_source_type": "observed",
  "sources": [
    {
      "id": "nicmar2025",
      "role": "Per-approach, per-turn hourly counts by vehicle class (Tables 1-6). All movement values in this file are transcribed from it.",
      "citation": "Khandekar, P. M., Bagwan, A. F., Karande, A. D., & Pilaka, N. (2025). Study of Traffic Management at Road Intersection in Pune. In Converging Horizons in Construction and the Built Environment: Digital, Sustainable, and Strategic Perspectives (Chapter 129, pp. 1462-1472). NICMAR University / Journal Press India. ISBN 978-93-49790-54-4.",
      "doi": "10.17492/jpi/nicmar/2507129",
      "url": "https://www.journalpressindia.com/siteadmin/upload_paper/1752236291_Chapter129_Study%20of%20Traffic%20Management.pdf",
      "sha256": "d291d2cea6ea87588ae0872115231016b7a5aa4621bf0384f35811b38edc720b"
    },
    {
      "id": "kureshi2026",
      "role": "Same six intersections and the same peak-hour totals (Table I); survey method (manual classified counts, 15-minute intervals, peak hour = highest four consecutive intervals; PHF 0.82-0.94). Published under CC BY 4.0.",
      "citation": "Kureshi, A. G., Kumar, C., Singh, A., Verma, P., Chauhan, M., & Rana, A. (2026). Study of Traffic Management at Selected Roadway Intersections in Pune. International Journal of Innovations in Research, 2(10), 33-39. Zenodo.",
      "doi": "10.5281/zenodo.21712996",
      "url": "https://zenodo.org/records/21712996",
      "sha256": "c161e76321c7474551fd6e26b26757c90e28aac067e989db939fb57e72b638de"
    }
  ],
  "survey": {
    "method": "Manual classified counts by four observers per junction, LV/HV/TW separately for right, straight and left at each approach, in 15-minute intervals; peak hour = the four consecutive 15-minute intervals with the highest combined volume (kureshi2026, section III.B).",
    "date": null,
    "date_note": "Neither source states the survey date. The NICMAR chapter was published in July 2025, so the counts were taken on or before then.",
    "period": "peak_hour",
    "peak_hour_clock": null,
    "peak_hour_note": "Neither source states the clock time of the peak hour or whether it is the morning or evening peak.",
    "phf_range": [
      0.82,
      0.94
    ],
    "phf_note": "Range across the six sites; per-site PHF not published."
  },
  "units": {
    "count": "veh/h",
    "classes": {
      "LV": "light vehicles",
      "HV": "heavy vehicles",
      "TW": "two-wheelers"
    },
    "class_note": "The sources do not define LV further (e.g. whether auto-rickshaws are LV)."
  },
  "pcu": {
    "standard": "IRC:106-1990, Guidelines for Capacity of Urban Roads in Plain Areas, Table 1",
    "url": "https://archive.org/stream/gov.in.irc.106.1990/irc.gov.in.106.1990_djvu.txt",
    "factors": {
      "LV": 1.0,
      "HV": 2.2,
      "TW": 0.75
    },
    "rationale": "Table 1 gives factors at 5% and at 10%+ share of the stream. Two-wheelers are about 45% of volume here, so the 10%+ value 0.75 is used. Heavy vehicles are under 5% at every site, so the 5% value for truck/bus, 2.2, is used. LV is taken as passenger car (1.0) because the source does not separate auto-rickshaws (IRC 1.2/2.0). IRC:106 is written for mid-block sections, so these PCU values are indicative only at junctions."
  },
  "approach_convention": "approach = the side traffic arrives from ('Traffic from approach road' N/S/E/W). Turns are as the driver sees them; India drives on the left, so from approach N: left = to E, straight = to S, right = to W.",
